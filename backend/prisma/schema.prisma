// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(uuid())
  email         String?           @unique
  passwordHash  String?           @db.Text
  name          String?
  avatarUrl     String?           @db.Text
  dateOfBirth   DateTime?
  phone         String?
  role          UserRole          @default(CANDIDATE)
  targetRole    String?
  customRole    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      InterviewSession[]
}

enum UserRole {
  CANDIDATE
  RECRUITER
}

model Problem {
  id          String            @id @default(uuid())
  slug        String            @unique
  title       String
  description String
  testCases   Json
  boilerplateCode Json
  isExecutable Boolean          @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sessions    InterviewSession[]
  submissions Submission[]
}

model InterviewSession {
  id          String       @id @default(uuid())
  userId      String?
  problemId   String
  status      SessionStatus @default(ACTIVE)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([userId])
  @@index([problemId])
}

model Submission {
  id                String           @id @default(uuid())
  sessionId         String
  problemId         String
  code              String
  language          String
  status            SubmissionStatus @default(QUEUED)
  executionTimeMs   Int?
  stdout            String?
  stderr            String?
  exitCode          Int?
  timedOut          Boolean          @default(false)
  aiFeedback        String?
  aiFeedbackAvailable Boolean?
  aiScore            Int?
  technicalScore     Int?
  createdAt         DateTime         @default(now())
  completedAt       DateTime?
  report            InterviewReport?
  session           InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  problem           Problem          @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@index([problemId, createdAt])
  @@index([status])
}

model InterviewReport {
  id              String     @id @default(uuid())
  submissionId    String     @unique
  shareToken      String     @unique @default(uuid())
  timeComplexity  String
  spaceComplexity String
  transcript      Json       @default("[]")
  communicationAssessment Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
